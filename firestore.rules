rules_version = '2';

// Millennial Gray Clay -- storefront rules.
//
// Anyone can READ the site design, the items and the pinned posts: that is
// the public website. Anyone can CREATE an inquiry, because that is the
// contact form. Nobody except a signed-in studio account can change the
// site or read the inquiries.
//
// Paste this into Firebase console > Firestore Database > Rules > Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Site design, sections, item types, shipping, pricing rules.
    match /site/{doc} {
      allow read:  if true;
      allow write: if signedIn();
    }

    // Everything for sale.
    match /items/{id} {
      allow read:  if true;
      allow write: if signedIn();
    }

    // Pinned social embeds.
    match /posts/{id} {
      allow read:  if true;
      allow write: if signedIn();
    }

    // Contact / buy inquiries. Visitors may drop one in and nothing else:
    // they cannot read, edit or delete any of them, including their own.
    //
    // hasOnly matters here: without it any field at all could be attached to
    // an inquiry, at any size, and the caps below would be decoration.
    // `status` is pinned to 'new' so nobody can post one pre-marked as seen
    // and slip past the unread count in Studio.
    match /inquiries/{id} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['name', 'email', 'message', 'shipping', 'itemId',
                          'itemTitle', 'itemPrice', 'options', 'optionsTotal',
                          'createdAt', 'status'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 200
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 320
                    && request.resource.data.get('status', '') == 'new'
                    && request.resource.data.get('message', '').size() < 5000
                    && request.resource.data.get('shipping', '').size() < 200
                    && request.resource.data.get('itemTitle', '').size() < 300
                    && request.resource.data.get('itemId', '').size() < 80
                    && request.resource.data.get('options', []).size() <= 12;
      allow read, update, delete: if signedIn();
    }

    // Order requests from the cart. Same shape of protection as inquiries:
    // anyone may send one, only a signed-in account may read them back --
    // these hold a home address and a phone number, so a leak here is worse
    // than a leaked question.
    //
    // Money is never taken by the site, so nothing here is a payment record.
    // `payment` is only the method they said they would prefer.
    match /orders/{id} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['name', 'email', 'phone', 'address', 'payment', 'shipping',
                          'shippingCost', 'items', 'subtotal', 'discountCode',
                          'discountPct', 'discountAmount', 'total', 'message',
                          'createdAt', 'status'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 200
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 320
                    && request.resource.data.get('phone', '').size() < 40
                    && request.resource.data.get('payment', '').size() < 120
                    && request.resource.data.get('shipping', '').size() < 200
                    && request.resource.data.get('message', '').size() < 5000
                    && request.resource.data.get('discountCode', '').size() < 60
                    && request.resource.data.status == 'new'
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 40
                    && request.resource.data.address.keys().hasOnly(
                         ['street', 'apt', 'city', 'state', 'zip'])
                    && request.resource.data.address.street is string
                    && request.resource.data.address.street.size() < 200
                    && request.resource.data.address.get('apt', '').size() < 100
                    && request.resource.data.address.city is string
                    && request.resource.data.address.city.size() < 100
                    && request.resource.data.address.state is string
                    && request.resource.data.address.state.size() <= 2
                    && request.resource.data.address.zip is string
                    && request.resource.data.address.zip.size() <= 10
                    // Totals are the customer's browser talking, so treat
                    // them as a claim to sanity-check, not as gospel. The
                    // real figure is the one confirmed by hand before any
                    // money changes hands.
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0
                    && request.resource.data.total < 1000000;
      allow read, update, delete: if signedIn();
    }

    // The outbox the "Trigger Email" extension watches. The website drops a
    // letter in here for each inquiry and the extension sends it.
    //
    // A visitor's browser does the writing, so without these rules this
    // would be an open mail relay: anyone could make your Firebase project
    // send email to anybody. So:
    //
    //   * `to` must equal the alert address saved in site/settings. Nobody
    //     can aim an email at a third party, only at you.
    //   * only the two fields the extension reads are allowed through, so
    //     no cc, bcc, replyTo, attachments or templates.
    //   * nobody can read this collection back. It holds your customers'
    //     messages and email addresses.
    //
    // What this does NOT stop: somebody could still submit the form over and
    // over and make your inbox noisy. They can already do that to the
    // inquiries list. The cap is that it can only ever reach you.
    match /mail/{id} {
      function alertTo() {
        return get(/databases/$(database)/documents/site/settings).data.get('notifyEmail', '');
      }
      allow create: if alertTo() != ''
                    && request.resource.data.keys().hasOnly(['to', 'message'])
                    && request.resource.data.to == alertTo()
                    && request.resource.data.message.keys().hasOnly(['subject', 'text'])
                    && request.resource.data.message.subject is string
                    && request.resource.data.message.subject.size() < 300
                    && request.resource.data.message.text is string
                    && request.resource.data.message.text.size() < 8000;
      allow read, update, delete: if signedIn();
    }

    // Anything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
