rules_version = '2';

// Millennial Gray Clay -- storefront rules.
//
// Anyone can READ the site design, the items and the pinned posts: that is
// the public website. Anyone can CREATE an inquiry, because that is the
// contact form. Nobody except a signed-in studio account can change the
// site or read the inquiries.
//
// Paste this into Firebase console > Firestore Database > Rules > Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Site design, sections, item types, shipping, pricing rules.
    match /site/{doc} {
      allow read:  if true;
      allow write: if signedIn();
    }

    // Everything for sale.
    match /items/{id} {
      allow read:  if true;
      allow write: if signedIn();
    }

    // Pinned social embeds.
    match /posts/{id} {
      allow read:  if true;
      allow write: if signedIn();
    }

    // Contact / buy inquiries. Visitors may drop one in and nothing else:
    // they cannot read, edit or delete any of them, including their own.
    match /inquiries/{id} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 200
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 320
                    && request.resource.data.get('message', '').size() < 5000
                    && request.resource.data.get('shipping', '').size() < 200
                    && request.resource.data.get('itemTitle', '').size() < 300;
      allow read, update, delete: if signedIn();
    }

    // The outbox the "Trigger Email" extension watches. The website drops a
    // letter in here for each inquiry and the extension sends it.
    //
    // A visitor's browser does the writing, so without these rules this
    // would be an open mail relay: anyone could make your Firebase project
    // send email to anybody. So:
    //
    //   * `to` must equal the alert address saved in site/settings. Nobody
    //     can aim an email at a third party, only at you.
    //   * only the two fields the extension reads are allowed through, so
    //     no cc, bcc, replyTo, attachments or templates.
    //   * nobody can read this collection back. It holds your customers'
    //     messages and email addresses.
    //
    // What this does NOT stop: somebody could still submit the form over and
    // over and make your inbox noisy. They can already do that to the
    // inquiries list. The cap is that it can only ever reach you.
    match /mail/{id} {
      function alertTo() {
        return get(/databases/$(database)/documents/site/settings).data.get('notifyEmail', '');
      }
      allow create: if alertTo() != ''
                    && request.resource.data.keys().hasOnly(['to', 'message'])
                    && request.resource.data.to == alertTo()
                    && request.resource.data.message.keys().hasOnly(['subject', 'text'])
                    && request.resource.data.message.subject is string
                    && request.resource.data.message.subject.size() < 300
                    && request.resource.data.message.text is string
                    && request.resource.data.message.text.size() < 8000;
      allow read, update, delete: if signedIn();
    }

    // Anything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
